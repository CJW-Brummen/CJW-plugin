{
  "name": "cjw-assets",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint:js": "eslint \"assets/**/*.js\"",
    "lint:css": "stylelint \"assets/**/*.css\"",
